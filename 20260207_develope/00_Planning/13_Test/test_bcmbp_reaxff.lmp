# ===================================================================
# 11_CHOCl.ff ReaxFF 파라미터 호환성 테스트
# 시스템: BCMBP (4,4'-bis(chloromethyl)-1,1'-biphenyl)
# 분자식: C14H12Cl2 (28 원자)
# ===================================================================

# 기본 설정
units real
atom_style charge
boundary p p p

# 구조 읽기
read_data bcmbp.data

# ===================================================================
# ReaxFF 설정 - 핵심 부분!
# ===================================================================
pair_style reaxff NULL safezone 3.0 mincap 150
pair_coeff * * 11_CHOCl.ff C H O Cl

# 전하 평형 (ReaxFF 필수)
fix qeq all qeq/reaxff 1 0.0 10.0 1.0e-6 reaxff

# 출력 설정
thermo 50
thermo_style custom step temp pe ke etotal press vol

print "=========================================="
print "BCMBP ReaxFF 호환성 테스트"
print "분자식: C14H12Cl2 (28 atoms)"
print "파라미터: 11_CHOCl.ff"
print "=========================================="

# ===================================================================
# 테스트 1: 에너지 최소화
# ===================================================================
print "=== 에너지 최소화 시작 ==="
minimize 1.0e-4 1.0e-6 1000 10000
print "=== 에너지 최소화 완료 ==="

# ===================================================================
# 테스트 2: 300K 평형화 (3 ps)
# ===================================================================
reset_timestep 0
timestep 0.25  # fs

velocity all create 300.0 12345 dist gaussian
fix nvt1 all nvt temp 300.0 300.0 100.0

dump 1 all custom 100 bcmbp_300K.lammpstrj id type x y z q
dump_modify 1 sort id

print "=== 300K 평형화 시작 (3 ps) ==="
run 12000  # 3 ps
print "=== 300K 평형화 완료 ==="

unfix nvt1
undump 1

# ===================================================================
# 테스트 3: 고온 안정성 (800K, 2 ps)
# BCMBP는 더 큰 분자이므로 800K 사용 (1000K 대신)
# ===================================================================
print "=== 가열 시작 (300K → 800K, 0.5 ps) ==="
fix nvt2 all nvt temp 300.0 800.0 100.0  # 가열
run 2000  # 0.5 ps 가열
print "=== 가열 완료 ==="

unfix nvt2
fix nvt3 all nvt temp 800.0 800.0 100.0

dump 2 all custom 100 bcmbp_800K.lammpstrj id type x y z q
dump_modify 2 sort id

print "=== 800K 고온 테스트 시작 (2 ps) ==="
run 8000  # 2 ps at 800K
print "=== 800K 고온 테스트 완료 ==="

unfix nvt3
undump 2

# ===================================================================
# 테스트 4: 냉각 및 안정화 (0.5 ps)
# ===================================================================
print "=== 냉각 시작 (800K → 300K, 0.5 ps) ==="
fix nvt4 all nvt temp 800.0 300.0 100.0
run 2000  # 0.5 ps 냉각
unfix nvt4
print "=== 냉각 완료 ==="

# 최종 구조 저장
write_data bcmbp_final.data

print "=========================================="
print "✅ BCMBP ReaxFF 테스트 완료!"
print "파라미터: 11_CHOCl.ff"
print "시스템: BCMBP C14H12Cl2 (28 원자)"
print "총 시뮬레이션: 6 ps"
print "출력 파일:"
print "  - bcmbp_300K.lammpstrj (300K 평형화)"
print "  - bcmbp_800K.lammpstrj (800K 고온)"
print "  - bcmbp_final.data (최종 구조)"
print "=========================================="