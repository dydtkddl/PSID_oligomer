# ===================================================================
# BCMBP 올리고머 형성 시뮬레이션 (수정 버전)
# 전략: 단계적 가열 → 반응 유도 → 냉각 안정화
# ===================================================================

units           real
atom_style      full
boundary        p p p
package         kokkos neigh half
newton          on

print "=========================================="
print "BCMBP Oligomerization Simulation"
print "Mechanism: C-Cl bond breaking -> Radical coupling"
print "=========================================="

# 1. 평형 벌크 구조 로드
read_data       bcmbp_bulk_equilibrated.data

# 2. ReaxFF 설정
pair_style      reaxff NULL safezone 4.0 mincap 300
pair_coeff      * * 11_CHOCl.lammps.ff C H Cl O
fix             qeq all qeq/reaxff 1 0.0 10.0 1.0e-6 reaxff

neighbor        2.5 bin
neigh_modify    every 5 delay 0 check yes

timestep        0.2

# 3. 화학 반응 분석 설정 (수정됨!)
# 1000 스텝마다 샘플링, 1회 측정, 1000 스텝마다 출력
# 수학적 검증: 1000 × 1 = 1000 ≤ 1000 ✅
fix             species all reaxff/species 1000 1 1000 species_oligo.out &
                element C H Cl O position 5000 5000

fix             bonds all reaxff/bonds 1000 bonds_oligo.reax

# 분자 크기 분석
compute         frag all fragment/atom
compute         mol_size all chunk/atom c_frag
compute         mol_count all property/chunk mol_size count

# 4. 출력 설정
thermo          1000
thermo_style    custom step temp press pe ke etotal vol density

# ===================================================================
# 단계 1: C-Cl 결합 활성화 (300K → 600K, 10 ps)
# ===================================================================
print ""
print "=== Step 1: C-Cl Bond Activation (300K -> 600K) ==="
velocity        all create 300.0 123456 dist gaussian

fix             heat1 all nvt temp 300.0 600.0 100.0
dump            d1 all custom 2000 05_activation.lammpstrj id type xu yu zu q c_frag
dump_modify     d1 sort id

run             50000  # 10 ps
undump          d1
unfix           heat1

# ===================================================================
# 단계 2: 라디칼 형성 (600K → 1000K → 유지, 30 ps)
# ===================================================================
print ""
print "=== Step 2: Radical Formation (600K -> 1000K) ==="

fix             heat2 all nvt temp 600.0 1000.0 100.0
run             25000  # 5 ps
unfix           heat2

print "High-temperature reaction zone (1000K, 25 ps)"
fix             react all nvt temp 1000.0 1000.0 100.0
dump            d2 all custom 1000 05_reaction.lammpstrj id type xu yu zu q c_frag
dump_modify     d2 sort id

run             125000  # 25 ps
undump          d2
unfix           react

# ===================================================================
# 단계 3: 올리고머 형성 (1000K → 500K, 25 ps)
# ===================================================================
print ""
print "=== Step 3: Oligomer Formation (1000K -> 500K) ==="

fix             cool1 all nvt temp 1000.0 500.0 100.0
dump            d3 all custom 1000 05_oligomerization.lammpstrj id type xu yu zu q c_frag
dump_modify     d3 sort id

run             125000  # 25 ps
undump          d3
unfix           cool1

# ===================================================================
# 단계 4: 안정화 (500K → 300K, 15 ps)
# ===================================================================
print ""
print "=== Step 4: Stabilization (500K -> 300K) ==="

fix             cool2 all nvt temp 500.0 300.0 100.0
run             50000  # 10 ps
unfix           cool2

fix             final all nvt temp 300.0 300.0 100.0
run             25000  # 5 ps
unfix           final

# ===================================================================
# 결과 저장
# ===================================================================
unfix           species
unfix           bonds

write_data      bcmbp_oligomer_final.data

print ""
print "=========================================="
print "SUCCESS: Oligomerization Simulation Complete!"
print "Total simulation time: 100 ps"
print ""
print "Key analysis files:"
print "  - species_oligo.out: Chemical species evolution"
print "  - bonds_oligo.reax: Bond formation/breaking"
print "  - 05_oligomerization.lammpstrj: Formation trajectory"
print "=========================================="